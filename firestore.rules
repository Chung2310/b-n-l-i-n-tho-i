rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} { 
      allow read, write: if false; 
    }

    // ─── Helper: lấy profile của người dùng đang request (single get() call) ───
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Role helpers — tất cả đọc từ myProfile() (1 get() call duy nhất per evaluation)
    function myRole() {
      return myProfile().role;
    }

    function myCompanyCode() {
      return myProfile().companyCode;
    }

    function isSuperAdmin() {
      return isAuthenticated() && myRole() == 'superadmin';
    }

    function isAdmin() {
      return isAuthenticated() && (myRole() == 'admin' || myRole() == 'superadmin');
    }

    function isManager() {
      return isAuthenticated() && myRole() == 'manager';
    }

    function isSameCompany(targetCompanyCode) {
      return myCompanyCode() == targetCompanyCode;
    }

    // ─── Helpers ──────────────────────────────────────────────────────────────
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\:\\.]+$'); 
    }

    function incoming() { 
      return request.resource.data; 
    }

    function existing() { 
      return resource.data; 
    }

    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // /users/{userId}
    // ══════════════════════════════════════════════════════════════════════════
    match /users/{userId} {
      // Đọc: chính mình | superadmin | cùng công ty
      allow read: if isAuthenticated() && (
        request.auth.uid == userId
        || isSuperAdmin()
        || isSameCompany(resource.data.companyCode)
      );

      // Tạo mới:
      //   • superadmin tạo bất kỳ ai
      //   • Người dùng tự tạo hồ sơ mình (role=user hoặc superadmin seed đặc biệt)
      //   • admin/manager tạo user/manager trong cùng công ty (không được tạo admin)
      allow create: if isAuthenticated() && (
        isSuperAdmin()
        || (request.auth.uid == userId && incoming().role == 'user')
        || (request.auth.uid == userId && incoming().role == 'superadmin' && incoming().email == 'superadmin@igen.com')
        || (
            (isAdmin() || isManager())
            && isSameCompany(incoming().companyCode)
            && (incoming().role == 'user' || incoming().role == 'manager')
          )
      );

      // Cập nhật:
      //   • chính mình nhưng không đổi role
      //   • superadmin@igen.com self-repair: cho phép cập nhật chính mình dù role field bị mất
      //   • superadmin cập nhật bất kỳ
      //   • admin cập nhật user/manager cùng công ty (không đụng superadmin)
      //   • manager cập nhật user cùng công ty (không đổi role, không đụng admin)
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && roleUnchanged())
        || (request.auth.uid == userId && request.auth.token.email == 'superadmin@igen.com' && incoming().role == 'superadmin')
        || isSuperAdmin()
        || (
            isAdmin()
            && isSameCompany(existing().companyCode)
            && existing().role != 'superadmin'
            && incoming().role != 'superadmin'
          )
        || (
            isManager()
            && isSameCompany(existing().companyCode)
            && roleUnchanged()
            && existing().role != 'superadmin'
            && existing().role != 'admin'
          )
      );

      // Xóa: 
      //   • superadmin xóa bất kỳ
      //   • superadmin@igen.com email bypass
      //   • admin xóa user/manager cùng công ty (không đụng superadmin)
      //   • manager xóa user cùng công ty (không đụng admin/superadmin/manager)
      allow delete: if isAuthenticated() && (
        isSuperAdmin()
        || (request.auth.uid == userId && request.auth.token.email == 'superadmin@igen.com')
        || (isAdmin() && isSameCompany(existing().companyCode) && existing().role != 'superadmin')
        || (isManager() && isSameCompany(existing().companyCode) && existing().role == 'user')
      );
    }

    // ══════════════════════════════════════════════════════════════════════════
    // /companies/{companyId}
    // ══════════════════════════════════════════════════════════════════════════
    match /companies/{companyId} {
      allow read:  if isAuthenticated();
      allow write: if isSuperAdmin()
        || (request.auth.token.email == 'superadmin@igen.com' && isAuthenticated());
    }

    // CRM Leads
    match /crmLeads/{leadId} {
      allow read, write: if isAuthenticated();
    }

    // Inventory products
    match /inventoryProducts/{productId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Inventory product categories
    match /inventoryProductCategories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Inventory stock logs (nhập / xuất kho)
    match /inventoryStockLogs/{logId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // /marketingContents/{contentId}
    // ══════════════════════════════════════════════════════════════════════════
    function isValidMarketingContent(data) {
      return data.keys().hasAll(['id', 'title', 'channel', 'contentType', 'status', 'bodyText', 'generatedAt'])
        && data.keys().size() <= 20
        && data.id is string && data.id.size() <= 100
        && data.title is string && data.title.size() <= 300
        && data.channel is string && data.channel.size() <= 50
        && data.contentType is string && data.contentType.size() <= 100
        && data.status is string && data.status.size() <= 50
        && data.bodyText is string && data.bodyText.size() <= 5000
        && data.generatedAt is string && data.generatedAt.size() <= 100;
    }

    match /marketingContents/{contentId} {
      function contentSameCompany() {
        return isSuperAdmin()
          || !('companyCode' in resource.data)
          || isSameCompany(resource.data.companyCode);
      }
      function incomingSameCompany() {
        return isSuperAdmin()
          || !('companyCode' in incoming())
          || isSameCompany(incoming().companyCode);
      }

      allow read: if isAuthenticated() && contentSameCompany() && (
        isAdmin()
        || isManager()
        || resource.data.authorUid == request.auth.uid
        || resource.data.authorUid == ''
      );

      allow create: if isAuthenticated()
        && isValidId(contentId)
        && incomingSameCompany()
        && isValidMarketingContent(incoming())
        && (isAdmin() || incoming().authorUid == request.auth.uid);

      allow update: if isAuthenticated()
        && isValidId(contentId)
        && contentSameCompany()
        && incomingSameCompany()
        && (
          isAdmin()
          || (
              (existing().authorUid == request.auth.uid || existing().authorUid == '')
              && (
                (existing().status == incoming().status && existing().status != 'published')
                || (existing().status == 'draft'     && incoming().status == 'pending')
                || (existing().status == 'pending'   && incoming().status == 'draft')
                || (existing().status == 'approved'  && incoming().status == 'scheduled')
                || (existing().status == 'scheduled' && incoming().status == 'approved')
                || (existing().status == 'scheduled' && incoming().status == 'published')
              )
            )
        );

      allow delete: if isAuthenticated() && contentSameCompany() && (
        isAdmin()
        || existing().authorUid == request.auth.uid
        || existing().authorUid == ''
      );
    }

    // ══════════════════════════════════════════════════════════════════════════
    // /projects/{projectId}
    // ══════════════════════════════════════════════════════════════════════════
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isSameCompany(resource.data.companyCode));
      allow create: if isAuthenticated() && (isSuperAdmin() || isSameCompany(incoming().companyCode));
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          isSameCompany(existing().companyCode) && 
          isSameCompany(incoming().companyCode)
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          (isAdmin() || isManager()) && 
          isSameCompany(existing().companyCode)
        )
      );
    }

    // ══════════════════════════════════════════════════════════════════════════
    // /kanbanTasks/{taskId}
    // ══════════════════════════════════════════════════════════════════════════
    match /kanbanTasks/{taskId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isSameCompany(resource.data.companyCode));
      allow create: if isAuthenticated() && (isSuperAdmin() || isSameCompany(incoming().companyCode));
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          isSameCompany(existing().companyCode) && 
          isSameCompany(incoming().companyCode)
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          (isAdmin() || isManager()) && 
          isSameCompany(existing().companyCode)
        )
      );
    }
    // ══════════════════════════════════════════════════════════════════════════
    // /trainingCourses/{courseId}
    // ══════════════════════════════════════════════════════════════════════════
    match /trainingCourses/{courseId} {
      // Đọc: mọi thành viên đã xác thực cùng công ty
      allow read: if isAuthenticated() && (isSuperAdmin() || isSameCompany(resource.data.companyCode));
      // Tạo mới: admin/manager/superadmin
      allow create: if isAuthenticated() && (isSuperAdmin() || (
        (isAdmin() || isManager()) && isSameCompany(incoming().companyCode)
      ));
      // Sửa: admin/manager/superadmin cùng công ty
      allow update: if isAuthenticated() && (isSuperAdmin() || (
        (isAdmin() || isManager()) &&
        isSameCompany(existing().companyCode) &&
        isSameCompany(incoming().companyCode)
      ));
      // Xóa: chỉ admin/superadmin
      allow delete: if isAuthenticated() && (isSuperAdmin() || (
        isAdmin() && isSameCompany(existing().companyCode)
      ));
    }

    // ══════════════════════════════════════════════════════════════════════════
    // /trainingEnrollments/{enrollmentId}
    // ══════════════════════════════════════════════════════════════════════════
    match /trainingEnrollments/{enrollmentId} {
      // Đọc: admin/manager đọc tất cả cùng công ty; user chỉ đọc enrollment của mình
      allow read: if isAuthenticated() && (
        isSuperAdmin()
        || ((isAdmin() || isManager()) && isSameCompany(resource.data.companyCode))
        || (resource.data.uid == request.auth.uid && isSameCompany(resource.data.companyCode))
      );
      // Tạo: admin/manager hoặc chính người học tự enroll
      allow create: if isAuthenticated() && (
        isSuperAdmin()
        || ((isAdmin() || isManager()) && isSameCompany(incoming().companyCode))
        || (incoming().uid == request.auth.uid && isSameCompany(incoming().companyCode))
      );
      // Sửa: chính người học cập nhật progress/status, hoặc admin/manager
      allow update: if isAuthenticated() && (
        isSuperAdmin()
        || ((isAdmin() || isManager()) && isSameCompany(existing().companyCode))
        || (existing().uid == request.auth.uid && isSameCompany(existing().companyCode))
      );
      // Xóa: chỉ admin/superadmin
      allow delete: if isAuthenticated() && (
        isSuperAdmin()
        || (isAdmin() && isSameCompany(existing().companyCode))
      );
    }
  }
}
