rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} { 
      allow read, write: if false; 
    }

    // Checking if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to get requesting user profile role from firestore
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Role-based helper functions
    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin' || getUserRole() == 'superadmin');
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'superadmin';
    }

    // ID validation gate
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\:\\.]+$'); 
    }

    // Helper functions for incoming data
    function incoming() { 
      return request.resource.data; 
    }

    function existing() { 
      return resource.data; 
    }

    // Helper to check if role field is not changed
    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    // Helper to get companyCode of requesting user
    function getMyCompanyCode() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyCode;
    }

    // Check if target company code matches requestor's company code
    function isSameCompany(targetCompanyCode) {
      return getMyCompanyCode() == targetCompanyCode;
    }

    // User document rules
    match /users/{userId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isSameCompany(resource.data.companyCode));
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        (request.auth.uid == userId && incoming().role == 'user')
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isAdmin() &&
          isSameCompany(existing().companyCode) &&
          existing().role != 'superadmin' &&
          incoming().role != 'superadmin'
        ) ||
        (
          request.auth.uid == userId &&
          roleUnchanged()
        )
      );
      allow delete: if isSuperAdmin() || (isAdmin() && isSameCompany(existing().companyCode) && existing().role != 'superadmin');
    }

    // Companies collection
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Validation Blueprint for Marketing Content Object
    function isValidMarketingContent(data) {
      return data.keys().hasAll(['id', 'title', 'channel', 'contentType', 'status', 'bodyText', 'generatedAt'])
        && data.keys().size() <= 20
        && data.id is string && data.id.size() <= 100
        && data.title is string && data.title.size() <= 300
        && data.channel is string && data.channel.size() <= 50
        && data.contentType is string && data.contentType.size() <= 100
        && data.status is string && data.status.size() <= 50
        && data.bodyText is string && data.bodyText.size() <= 5000
        && data.generatedAt is string && data.generatedAt.size() <= 100;
    }

    // Hardened path rules for marketing content
    match /marketingContents/{contentId} {
      function isContentSameCompany() {
        return isSuperAdmin() || !('companyCode' in resource.data) || isSameCompany(resource.data.companyCode);
      }
      function isIncomingSameCompany() {
        return isSuperAdmin() || !('companyCode' in incoming()) || isSameCompany(incoming().companyCode);
      }

      // User chỉ đọc content của chính mình hoặc admin đọc tất cả trong cùng doanh nghiệp
      allow read: if isAuthenticated() && isContentSameCompany() && (
        isAdmin()
        || resource.data.authorUid == request.auth.uid
        || resource.data.authorUid == ''
      );
      // User được tạo content trong cùng doanh nghiệp
      allow create: if isAuthenticated() && isValidId(contentId) && isIncomingSameCompany() && isValidMarketingContent(incoming()) && (
        isAdmin()
        || incoming().authorUid == request.auth.uid
      );
      allow update: if isAuthenticated() && isValidId(contentId) && isContentSameCompany() && isIncomingSameCompany() && (
        isAdmin()
        || (
          (existing().authorUid == request.auth.uid || existing().authorUid == '')
          && (
            (existing().status == incoming().status && existing().status != 'published')
            || (existing().status == 'draft' && incoming().status == 'pending')
            || (existing().status == 'pending' && incoming().status == 'draft')
            || (existing().status == 'approved' && incoming().status == 'scheduled')
            || (existing().status == 'scheduled' && incoming().status == 'approved')
            || (existing().status == 'scheduled' && incoming().status == 'published')
          )
        )
      );
      allow delete: if isAuthenticated() && isContentSameCompany() && (
        isAdmin() || existing().authorUid == request.auth.uid || existing().authorUid == ''
      );
    }
  }
}
