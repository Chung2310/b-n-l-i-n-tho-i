{
  "entities": {
    "marketingContent": {
      "title": "Marketing Content",
      "description": "Bản thảo, bài viết, kịch bản marketing được đồng bộ hóa và quản lý trạng thái.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "channel": { "type": "string", "enum": ["Facebook", "TikTok", "LinkedIn", "Instagram"] },
        "contentType": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "pending", "approved", "scheduled"] },
        "bodyText": { "type": "string" },
        "imageUrl": { "type": "string" },
        "generatedAt": { "type": "string" },
        "feedback": { "type": "string" }
      },
      "required": ["id", "title", "channel", "contentType", "status", "bodyText", "generatedAt"]
    }
  },
  "firestore": {
    "marketingContents/{contentId}": {
      "schema": "marketingContent",
      "description": "Bộ sưu tập quản lý các bản nháp, bài duyệt và lịch đăng marketing"
    }
  }
}
